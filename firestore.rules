rules_version = '2';

// Reglas de RedNexo. Contienen datos de menores: todo está denegado salvo lo indicado.
// El rol se valida aquí, en el servidor; la interfaz solo refleja lo que estas reglas permiten.
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Identidad y roles ──────────────────────────────────────────
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function myEmail() {
      return request.auth.token.email.lower();
    }
    // Superadmin RAÍZ (dueño de la plataforma). Para cambiarlo hay que editar y desplegar este archivo.
    // Es la salida de emergencia: nadie puede quitarle el acceso desde la aplicación.
    function isRoot() {
      return signedIn() && myEmail() in ['franksanlo@gmail.com'];
    }
    // Superadmin = raíz, o una cuenta activa en superadmins/{correo} (solo la raíz las administra).
    function isSuper() {
      return isRoot() || (signedIn()
        && exists(/databases/$(database)/documents/superadmins/$(myEmail()))
        && get(/databases/$(database)/documents/superadmins/$(myEmail())).data.get('activo', false) == true);
    }
    function userPath() {
      return /databases/$(database)/documents/users/$(myEmail());
    }
    function isActiveUser() {
      return signedIn() && exists(userPath()) && get(userPath()).data.status == 'active';
    }
    // Lectura: superadmin y cualquier usuario autorizado y activo (psicólogo o solo lectura).
    function canRead() {
      return isSuper() || isActiveUser();
    }
    // Escritura: superadmin y psicólogos activos. "readonly" nunca escribe.
    function canWrite() {
      return isSuper() || (isActiveUser() && get(userPath()).data.role == 'psychologist');
    }

    // ── Encuesta pública (sin sesión) ──────────────────────────────
    function surveyPath(id) {
      return /databases/$(database)/documents/surveys/$(id);
    }
    function isOpenSurvey(sv) {
      return sv.status == 'active' && sv.get('deleted', false) != true;
    }
    function validSubmission(rid) {
      let d = request.resource.data;
      return d.keys().hasOnly(['surveyId', 'respondentId', 'respondentName', 'answers', 'submittedAt'])
        && d.keys().hasAll(['surveyId', 'respondentId', 'respondentName', 'answers', 'submittedAt'])
        && d.surveyId is string
        && exists(surveyPath(d.surveyId))
        && isOpenSurvey(get(surveyPath(d.surveyId)).data)
        && rid == d.surveyId + '_' + string(d.respondentId)
        && string(d.respondentId) in get(surveyPath(d.surveyId)).data.get('rosterIds', [])
        && d.respondentName is string && d.respondentName.size() <= 120
        && d.answers is map && d.answers.size() <= 50
        && d.submittedAt == request.time;
    }
    function validMark(rid) {
      let d = request.resource.data;
      return d.keys().hasOnly(['surveyId', 'respondentId'])
        && d.surveyId is string
        && exists(surveyPath(d.surveyId))
        && isOpenSurvey(get(surveyPath(d.surveyId)).data)
        && rid == d.surveyId + '_' + string(d.respondentId)
        && string(d.respondentId) in get(surveyPath(d.surveyId)).data.get('rosterIds', []);
    }

    // ══════════ MULTI-COLEGIO: colegios/{cid}/... ══════════
    // Cada colegio es una isla: el rol se lee de colegios/{cid}/miembros/{correo} del MISMO colegio,
    // así que ser miembro de A no da ningún acceso a B. Solo el superadmin crea colegios.
    function memberPath(cid) {
      return /databases/$(database)/documents/colegios/$(cid)/miembros/$(myEmail());
    }
    function isMember(cid) {
      return signedIn() && exists(memberPath(cid)) && get(memberPath(cid)).data.status == 'active';
    }
    function memberRole(cid) {
      return get(memberPath(cid)).data.role;
    }
    // Un colegio suspendido (estado != 'activo') queda bloqueado para sus miembros y para su encuesta pública;
    // sus datos se conservan y solo el superadmin puede entrar.
    // Licencia (campo opcional colegios/{cid}.licencia = { vence, graciaDias }): sin ella no hay restricción.
    //   hasta `vence`                     → lectura y escritura
    //   hasta `vence` + graciaDias (15)   → solo lectura
    //   después                           → bloqueado (los datos se conservan; renovar lo reabre al instante)
    function colegioDoc(cid) {
      return get(/databases/$(database)/documents/colegios/$(cid)).data;
    }
    function licVence(cid) {
      return colegioDoc(cid).get('licencia', {}).get('vence', null);
    }
    function licGracia(cid) {
      return duration.value(colegioDoc(cid).get('licencia', {}).get('graciaDias', 15), 'd');
    }
    function licLectura(cid) {
      return licVence(cid) == null || request.time <= licVence(cid) + licGracia(cid);
    }
    function licEscritura(cid) {
      return licVence(cid) == null || request.time <= licVence(cid);
    }
    // Lectura: no suspendido y licencia dentro de la gracia.
    function colegioActivo(cid) {
      return colegioDoc(cid).get('estado', 'activo') == 'activo' && licLectura(cid);
    }
    // Escritura (y encuesta pública): no suspendido y licencia vigente (no en gracia).
    function colegioEscribible(cid) {
      return colegioDoc(cid).get('estado', 'activo') == 'activo' && licEscritura(cid);
    }
    function cRead(cid)  { return isSuper() || (isMember(cid) && colegioActivo(cid)); }
    function cWrite(cid) { return isSuper() || (isMember(cid) && colegioEscribible(cid) && memberRole(cid) in ['admin', 'psychologist']); }
    function cAdmin(cid) { return isSuper() || (isMember(cid) && colegioActivo(cid) && memberRole(cid) == 'admin'); }
    function cAdminW(cid) { return isSuper() || (isMember(cid) && colegioEscribible(cid) && memberRole(cid) == 'admin'); }

    function cSurveyPath(cid, id) {
      return /databases/$(database)/documents/colegios/$(cid)/surveys/$(id);
    }
    function cValidSubmission(cid, rid) {
      let d = request.resource.data;
      return d.keys().hasOnly(['surveyId', 'respondentId', 'respondentName', 'answers', 'submittedAt'])
        && d.keys().hasAll(['surveyId', 'respondentId', 'respondentName', 'answers', 'submittedAt'])
        && d.surveyId is string
        && exists(cSurveyPath(cid, d.surveyId))
        && colegioEscribible(cid)
        && isOpenSurvey(get(cSurveyPath(cid, d.surveyId)).data)
        && rid == d.surveyId + '_' + string(d.respondentId)
        && string(d.respondentId) in get(cSurveyPath(cid, d.surveyId)).data.get('rosterIds', [])
        && d.respondentName is string && d.respondentName.size() <= 120
        && d.answers is map && d.answers.size() <= 50
        && d.submittedAt == request.time;
    }
    function cValidMark(cid, rid) {
      let d = request.resource.data;
      return d.keys().hasOnly(['surveyId', 'respondentId'])
        && d.surveyId is string
        && exists(cSurveyPath(cid, d.surveyId))
        && colegioEscribible(cid)
        && isOpenSurvey(get(cSurveyPath(cid, d.surveyId)).data)
        && rid == d.surveyId + '_' + string(d.respondentId)
        && string(d.respondentId) in get(cSurveyPath(cid, d.surveyId)).data.get('rosterIds', []);
    }

    match /colegios/{cid} {
      // Un miembro puede leer su colegio aunque esté suspendido (para ver el aviso); sus datos no.
      allow get: if isSuper() || isMember(cid);
      allow list: if isSuper();
      allow create, update, delete: if isSuper();

      match /miembros/{email} {
        allow get: if cAdmin(cid) || (signedIn() && email == myEmail());
        allow list: if cAdmin(cid);
        allow create, update: if cAdminW(cid)
          && request.resource.data.email == email
          && request.resource.data.role in ['admin', 'psychologist', 'readonly']
          && request.resource.data.status in ['active', 'revoked', 'pending'];
        allow delete: if cAdminW(cid);
      }
      match /students/{id} {
        allow read: if cRead(cid);
        allow create, update: if cWrite(cid)
          && request.resource.data.name is string
          && request.resource.data.group is string;
        allow delete: if cWrite(cid);
      }
      match /groups/{id} {
        allow read: if cRead(cid);
        allow create, update: if cWrite(cid) && request.resource.data.name is string;
        allow delete: if cWrite(cid);
      }
      match /surveys/{id} {
        allow get: if (isOpenSurvey(resource.data) && colegioEscribible(cid)) || cRead(cid);
        allow list: if cRead(cid);
        allow create, update, delete: if cWrite(cid);
      }
      match /responses/{rid} {
        allow read: if cRead(cid);
        // El superadmin también puede crear (copia de respuestas históricas al migrar); nadie más sin cumplir el formato.
        allow create: if cValidSubmission(cid, rid) || isSuper();
        allow update: if isSuper();   // solo para repetir la migración; el público nunca actualiza
        allow delete: if cAdminW(cid);
      }
      match /responseMarks/{rid} {
        allow get: if true;
        allow list: if cRead(cid);
        allow create: if cValidMark(cid, rid) || isSuper();
        allow update: if isSuper();
        allow delete: if cAdminW(cid);
      }
      match /activity/{id} {
        allow read, delete: if cAdmin(cid);
        // Una entrada solo puede escribirse a nombre de quien la crea, con la hora del servidor y con el formato esperado.
        // (El superadmin queda exento para poder copiar el registro antiguo al migrar.)
        allow create: if isSuper() || (cWrite(cid)
          && request.resource.data.keys().hasOnly(['type', 'action', 'detail', 'user', 'email', 'createdAt'])
          && request.resource.data.keys().hasAll(['type', 'action', 'user', 'email', 'createdAt'])
          && request.resource.data.type in ['create', 'survey', 'group', 'user', 'export', 'report', 'system']
          && request.resource.data.action is string && request.resource.data.action.size() <= 200
          && request.resource.data.get('detail', '') is string && request.resource.data.get('detail', '').size() <= 300
          && request.resource.data.user is string && request.resource.data.user.size() <= 120
          && request.resource.data.email == myEmail()
          && request.resource.data.createdAt == request.time);
        allow update: if isSuper();   // solo para repetir la migración; la auditoría no se edita
      }
      // Gestión comercial (datos legales, pagos, historial de licencias y contratos): SOLO el superadmin.
      // Un colegio nunca ve lo que paga ni los datos de otros; tampoco entra en su exportación.
      match /legal/{id}     { allow read, write: if isSuper(); }
      match /pagos/{id}     { allow read, write: if isSuper(); }
      match /historial/{id} { allow read, write: if isSuper(); }
      match /contratos/{id} { allow read, write: if isSuper(); }
      match /settings/{id} {
        allow read: if cRead(cid);
        allow create, update: if cAdminW(cid)
          && request.resource.data.get('logo', '').size() <= 300000;
        allow delete: if cAdminW(cid);
      }
    }

    // Planes y precios: los lee cualquier sesión (para mostrar el plan del colegio); solo el superadmin los cambia.
    match /plataforma/planes {
      allow read: if signedIn();
      allow write: if isSuper();
    }
    // Resto de la plataforma (datos legales de la empresa para el contrato): solo el superadmin.
    match /plataforma/{id} {
      allow read, write: if isSuper();
    }

    // Superadmins adicionales (cuentas de la empresa). Cada quien puede ver si es superadmin; solo la raíz los administra.
    match /superadmins/{email} {
      allow get: if isSuper() || (signedIn() && email == myEmail());
      allow list: if isSuper();
      allow create, update: if isRoot() && request.resource.data.email == email && request.resource.data.activo is bool;
      allow delete: if isRoot();
    }

    // Bitácora de acciones sensibles (suspender, exportar, eliminar, acceso de soporte). No se edita ni se borra.
    match /auditoria/{id} {
      allow read: if isSuper();
      allow create: if signedIn()
        && request.resource.data.por == myEmail()
        && request.resource.data.accion is string
        && request.resource.data.colegio is string
        && (isSuper() || cAdmin(request.resource.data.colegio));
      allow update, delete: if false;
    }

    // Consulta "¿en qué colegios estoy?": cada persona solo ve SUS propias membresías.
    match /{path=**}/miembros/{email} {
      allow list: if signedIn() && resource.data.email == myEmail();
    }

    // ── Colecciones ────────────────────────────────────────────────
    match /users/{email} {
      allow get: if isSuper() || (signedIn() && email == myEmail());
      allow list: if isSuper();
      allow write: if isSuper();
    }

    match /students/{id} {
      allow read: if canRead();
      allow create, update: if canWrite()
        && request.resource.data.name is string
        && request.resource.data.group is string;
      allow delete: if canWrite();
    }

    match /groups/{id} {
      allow read: if canRead();
      allow create, update: if canWrite() && request.resource.data.name is string;
      allow delete: if canWrite();
    }

    match /surveys/{id} {
      // Una persona sin sesión solo puede LEER UNA encuesta activa por su id; nunca listar.
      allow get: if isOpenSurvey(resource.data) || canRead();
      allow list: if canRead();
      allow create, update, delete: if canWrite();
    }

    match /responses/{rid} {
      allow read: if canRead();
      allow create: if validSubmission(rid);   // sin update: una respuesta no se puede sobrescribir
      allow delete: if isSuper();
    }

    // Marca vacía que permite a la encuesta pública saber si alguien ya respondió, sin leer respuestas.
    match /responseMarks/{rid} {
      allow get: if true;
      allow list: if canRead();
      allow create: if validMark(rid);
      allow delete: if isSuper();
    }

    match /activity/{id} {
      allow read, delete: if isSuper();
      allow create: if canWrite();
    }

    match /settings/{id} {
      allow read: if canRead();
      allow write: if isSuper();
    }
  }
}
